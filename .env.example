# Frontend environment for local development. Copy to `.env.local`; never commit real values.

# The FastAPI backend the server-side routes (app/api/*) call. Locally: the backend from
# `./dev.sh` in backend-spiritualized-ai-bot. In `next dev` the frontend never falls back to
# NEXT_PUBLIC_API_URL, so a missing value means the local backend, never production.
BACKEND_URL=http://localhost:8000

# Production (Vercel) sets NEXT_PUBLIC_API_URL to the Railway backend. Leave it empty locally.
NEXT_PUBLIC_API_URL=
